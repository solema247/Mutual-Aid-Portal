# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# GCP credentials
.gcp/
*.json.key
*-credentials.json
*-service-account.json
*-web-chat-*.json

# Logs
/logs
*.log

# Supabase CLI (local link state — do not commit)
.supabase/

# Production schema lives in private sudan-err-portal-schema repo
/supabase/migrations/
/supabase/config.toml

# Cursor MCP — local only (contains project ref)
.cursor/mcp.json

# Internal cutover notes — do not commit
LOCAL_PROD_CUTOVER_PLAN.md

# Local Storage / data migration helpers — do not commit
scripts/sync-storage-bucket.js
scripts/retry-storage-paths.js
scripts/copy-approved-beneficiaries.js
scripts/fix-prod-arabic.js

# Local CSV imports/exports — not committed
data/imports/*
!data/imports/.gitkeep
data/exports/*
!data/exports/.gitkeep
